table 'Time calculation'
	lineageTag: 2ddf7fc0-88a2-465c-929f-307e893aa81b

	calculationGroup

		calculationItem 'Year-to-Date (YTD)' = CALCULATE(SELECTEDMEASURE(), DATESYTD('Date'[Date]))

		calculationItem 'Previous Year (PY)' = CALCULATE(SELECTEDMEASURE(), PREVIOUSYEAR('Date'[Date]))

		calculationItem 'Year-over-Year (YoY) Growth' =
				
				VAR MeasurePriorYear =
				CALCULATE(
				    SELECTEDMEASURE(),
				    SAMEPERIODLASTYEAR('Date'[Date])
				)
				RETURN
				DIVIDE(
				    (SELECTEDMEASURE() - MeasurePriorYear),
				    MeasurePriorYear
				)

			formatStringDefinition = "0.##%"

	column 'Yearly calculations'
		dataType: string
		lineageTag: fcd642d4-16b6-4fc9-8888-3b1bfe40b1b0
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: 2ee66811-d85a-4b53-b24b-d024afcef12f
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

