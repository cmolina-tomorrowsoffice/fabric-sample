.create-merge table stock (['time']:datetime, symbol:string, sector:string, securityType:string, bidPrice:real, bidSize:int, askPrice:int, askSize:int, lastSalePrice:real, lastSaleSize:int, volume:int, marketPercent:real, seq:int, lastUpdated:datetime, lastSaleTime:datetime) 
.create-or-alter table stock ingestion json mapping 'stock_mapping'
