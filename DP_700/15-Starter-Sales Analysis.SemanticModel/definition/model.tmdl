model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Salesperson (Performance)","SalespersonRegion","Product","Reseller","Region","Sales","Targets","ColorFormats","SQLInstance","Database","RangeStart","RangeEnd"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["CalcGroup","WebModelingEdit"]

ref table 'Salesperson (Performance)'
ref table SalespersonRegion
ref table Product
ref table Reseller
ref table Region
ref table Sales
ref table Targets
ref table Salesperson
ref table Date
ref table 'Time calculation'
ref table 'Sales Figures'

ref cultureInfo en-US

